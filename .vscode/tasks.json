{
  // Runs automatically when the folder opens, in its own terminal panel, so
  // the Mobile Agent server output and errors are visible. It starts the
  // server if needed, then follows /tmp/mobile-agent.log. Stop the task to
  // stop following; the server itself keeps running in the background.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobile Agent: start",
      "type": "shell",
      "command": "bash scripts/codespace-start.sh && tail -n +1 -f /tmp/mobile-agent.log",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Mobile Agent: build web",
      "type": "shell",
      "command": "npm run build:web",
      "problemMatcher": []
    },
    {
      "label": "Mobile Agent: server tests",
      "type": "shell",
      "command": "npm run test:server",
      "problemMatcher": []
    }
  ]
}
