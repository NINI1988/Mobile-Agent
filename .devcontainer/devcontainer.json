{
  "name": "Mobile Agent",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [12000],
  "portsAttributes": {
    "12000": {
      "label": "Mobile Agent",
      "onAutoForward": "openBrowser"
    }
  },
  // One-time setup: build the web bundle and install the Codex ACP agent
  // globally so the first session starts instantly (no npx download).
  "postCreateCommand": "npm install && npm run build:web && (npm install -g @agentclientprotocol/codex-acp@latest || echo 'codex-acp global install failed; server will fall back to npx')",
  // Every start: launch the server if it isn't already running. It serves the
  // web app, the WebSocket ACP bridge, and keeps agent sessions alive across
  // phone disconnects. Opening the forwarded port auto-opens the browser.
  "postStartCommand": "pgrep -f 'server/index.mjs' >/dev/null || (MOBILE_AGENT_OPEN=0 nohup npm start > /tmp/mobile-agent.log 2>&1 &)",
  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar"]
    }
  },
  "remoteUser": "node"
}
