{
  "name": "mobile-agent",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dev:web": "vite --mode web",
    "build:web": "vue-tsc --noEmit && vite build --mode web",
    "preview:web": "vite preview --mode web --outDir dist-web",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "serve": "npm run build:web && node server/index.mjs",
    "dev:server": "node server/index.mjs",
    "test:server": "node --test server/test/server.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.13.1",
    "@microsoft/applicationinsights-web": "^3.3.11",
    "@tauri-apps/api": "^2",
